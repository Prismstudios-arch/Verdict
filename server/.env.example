# Copy to server/.env and fill in.

# ---- AI provider (pick ONE — or set both and AI_PROVIDER to choose) ----
# Option A (quality): Anthropic — console.anthropic.com (paid, ~£0.05-0.10/audit)
ANTHROPIC_API_KEY=
# Option B (FREE): Google AI Studio — https://aistudio.google.com/apikey
# Free tier is plenty for testing (~10 req/min; each audit = 3 requests).
# Note: Google may use free-tier inputs to improve its models — fine for
# testing public sites, use Anthropic (or paid Gemini) for production.
GEMINI_API_KEY=

# Optional: force a provider ("anthropic" | "gemini"). Default: Anthropic if
# keyed, else Gemini.
AI_PROVIDER=
VERDICT_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-flash

# ---- Free persistence (needed on free hosts with ephemeral disks) ----
# Supabase free tier: supabase.com → New project → create a PRIVATE storage
# bucket named "verdict" → Settings → API: copy the Project URL and the
# service_role key. With these set, state + screenshots survive restarts.
# Leave empty for local dev (files persist on your own disk anyway).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=verdict

# Global audits/day cap (0 = unlimited). Set this when using Gemini's free
# tier so you never exceed the daily quota mid-audit:
#   gemini-2.5-flash free ≈ 250 req/day → set 80
#   gemini-2.5-flash-lite free ≈ 1000 req/day → set 300
MAX_AUDITS_PER_DAY=0

# RevenueCat webhook auth: set the same value as the Authorization header
# ("Bearer <value>") you configure in the RevenueCat dashboard webhook.
RC_WEBHOOK_SECRET=

# Dev mode enables POST /v1/dev/simulate-purchase (used by the app inside
# Expo Go where native IAP is unavailable). MUST be false in production.
DEV_MODE=true

# Free credits granted to each new anonymous device (production: 1).
FREE_AUDIT_CREDITS=3

PORT=8787
WORKER_CONCURRENCY=2
