# ---- Dependencies ----
**/node_modules/

# ---- Secrets & environment (NEVER commit) ----
**/.env
**/.env.local
**/.env.*.local
# real secrets live in the data dir; keep .env.example templates tracked
server/data/
server/storage/

# ---- Build output ----
**/dist/
mobile/.expo/
mobile/web-build/
mobile/expo-env.d.ts
**/*.tsbuildinfo

# ---- Generated native folders (regenerated by EAS) ----
mobile/ios/
mobile/android/

# ---- Signing keys / credentials ----
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
npm-debug.*
yarn-debug.*
yarn-error.*
